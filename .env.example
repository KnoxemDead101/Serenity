# Settings Serenity reads from environment variables.
# Everything here is OPTIONAL; the defaults work out of the box.
#
# On Replit: add these in the "Secrets" tab.
# Locally:   set them in your shell (e.g. export DATABASE_URL=...).
# Note: Serenity does not auto-load a .env file yet. That can be added later.
# Never commit real secrets.

# Local development defaults to SQLite.
DATABASE_URL=sqlite:///./serenity.db

# Replit supplies its managed PostgreSQL DATABASE_URL automatically in
# development and production. Do not copy a real connection string here.
